{
  "name": "@redhat-cloud-services/javascript-clients",
  "version": "0.0.1",
  "description": "Javascript clients for swagger API",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "install": "mvn install -q -DskipTests",
    "build:generator": "mvn clean package -q -DskipTests",
    "create-client": "utils/create-client.sh",
    "doc": "npm run doc --workspaces",
    "nx": "nx",
    "nx:reset": "nx reset",
    "prepare": "husky install",
    "dev": "nx run test-app:serve",
    "test:unit": "nx run-many -t test --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "test:unit:affected": "nx affected -t test --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "test:integration": "npm run build:no-cache && nx run-many --parallel=1 -t integration-v1,integration-v2 --exclude=@redhat-cloud-services/CLIENTNAME-client --skip-nx-cache",
    "test": "npm-run-all --parallel test:*",
    "build": "nx run-many -t build --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "build:no-cache": "npm run build -- --skip-nx-cache",
    "generate": "nx run-many -t generate --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "lint": "nx run-many -t lint --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "lint:fix": "nx run-many -t lint --fix --exclude=@redhat-cloud-services/CLIENTNAME-client"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedHatInsights/javascript-clients.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/RedHatInsights/javascript-clients/issues"
  },
  "homepage": "https://github.com/RedHatInsights/javascript-clients#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "eslint-plugin-prettier": "^5.0.1",
    "fs-extra": "^11.4.0",
    "@nx/cypress": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/plugin": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@stoplight/prism-cli": "^5.16.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "tslib": "^2.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "husky": "^8.0.3",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "30.4.1",
    "jest-util": "30.4.1",
    "jsonc-eslint-parser": "^3.3.0",
    "npm-run-all": "^4.1.5",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "start-server-and-test": "^2.0.8",
    "swc-loader": "^0.2.3",
    "ts-jest": "29.4.12",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.0",
    "webpack-cli": "^6.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postman-collection": {
      "lodash": "4.18.1"
    }
  }
}
