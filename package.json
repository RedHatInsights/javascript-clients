{
  "name": "@redhat-cloud-services/javascript-clients",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.6.0"
  },
  "packageManager": "npm@12.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "description": "Javascript clients for swagger API",
  "main": "index.js",
  "scripts": {
    "install": "mvn install -q -DskipTests",
    "build:generator": "mvn clean package -q -DskipTests",
    "create-client": "utils/create-client.sh",
    "doc": "npm run doc --workspaces",
    "nx": "nx",
    "nx:reset": "nx reset",
    "prepare": "husky install",
    "dev": "nx run test-app:serve",
    "test:unit": "nx run-many -t test --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "test:unit:affected": "nx affected -t test --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "test:integration": "npm run build:no-cache && nx run-many --parallel=1 -t integration-v1,integration-v2 --exclude=@redhat-cloud-services/CLIENTNAME-client --skip-nx-cache",
    "test": "npm-run-all --parallel test:*",
    "build": "nx run-many -t build --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "build:no-cache": "npm run build -- --skip-nx-cache",
    "generate": "nx run-many -t generate --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "lint": "nx run-many -t lint --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "lint:fix": "nx run-many -t lint --fix --exclude=@redhat-cloud-services/CLIENTNAME-client",
    "test:commitlint": "NODE_OPTIONS=--experimental-vm-modules jest --config=commitlint.jest.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedHatInsights/javascript-clients.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/RedHatInsights/javascript-clients/issues"
  },
  "homepage": "https://github.com/RedHatInsights/javascript-clients#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "@nx/cypress": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/plugin": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "tslib": "^2.8.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-environment-node": "30.5.2",
    "jest-util": "30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "npm-run-all2": "^5.0.2",
    "nx": "23.2.1",
    "prettier": "^3.9.8",
    "start-server-and-test": "^2.1.5",
    "swc-loader": "^0.2.7",
    "ts-jest": "29.4.12",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3",
    "webpack-cli": "^7.2.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "postman-collection": {
      "lodash": "4.18.1"
    }
  }
}
